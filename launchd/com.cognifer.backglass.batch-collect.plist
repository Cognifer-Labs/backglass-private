<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cognifer.backglass.batch-collect</string>

  <!-- Optional — batch mode only. Collects overnight batch results at 05:30 so the
       morning brief (06:00) reports on batch-extracted commitments. A batch that is
       not finished yet is simply left for the next collect; the brief never waits. -->
  <key>WorkingDirectory</key><string>/Users/Dharsan/Downloads/backglass</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/Dharsan/.local/bin/uv</string>
    <string>run</string>
    <string>backglass</string>
    <string>batch</string>
    <string>collect</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key><string>/Users/Dharsan/Downloads/backglass/data/batch-collect.log</string>
  <key>StandardErrorPath</key><string>/Users/Dharsan/Downloads/backglass/data/batch-collect.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
