<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.backglass.plan</string>

  <!-- Absolute paths: launchd has no shell and no useful PATH. -->
  <key>WorkingDirectory</key><string>{{REPO_DIR}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{UV_BIN}}</string>
    <string>run</string>
    <string>backglass</string>
    <string>plan</string>
  </array>

  <!-- Deliberately WITHOUT the if-missing flag the catch-up job carries: this is the run
       built on the overnight batch collect, and it must be able to replace a thinner
       plan a pre-dawn login wrote. launchd defers a missed calendar interval to the next
       wake, so on a machine that sleeps through this hour the job fires in the evening;
       that is handled in the planner, which packs the day from the current time rather
       than from the start of a window that has already passed, not by skipping the run.
       (No double hyphen appears in this comment on purpose: XML forbids it.) -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>{{PLAN_HOUR}}</integer><key>Minute</key><integer>{{PLAN_MINUTE}}</integer></dict>

  <!-- docs/02 §Failure policy: the process exits non-zero at the end so a scheduled run
       reports failure. These logs are where that lands. -->
  <key>StandardOutPath</key><string>{{REPO_DIR}}/data/plan.log</string>
  <key>StandardErrorPath</key><string>{{REPO_DIR}}/data/plan.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
