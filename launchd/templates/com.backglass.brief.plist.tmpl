<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.backglass.brief</string>

  <!-- Absolute paths: launchd has no shell and no useful PATH. -->
  <key>WorkingDirectory</key><string>{{REPO_DIR}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{UV_BIN}}</string>
    <string>run</string>
    <string>backglass</string>
    <string>brief</string><string>--send</string>
  </array>

  <!-- BRIEF_AT, filled in by render(). Two places claiming the delivery hour is one
       place too many; this one used to be right only by coincidence. -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>{{BRIEF_HOUR}}</integer><key>Minute</key><integer>{{BRIEF_MINUTE}}</integer></dict>

  <!-- docs/02 §Failure policy: the process exits non-zero at the end so a scheduled run
       reports failure. These logs are where that lands. -->
  <key>StandardOutPath</key><string>{{REPO_DIR}}/data/brief.log</string>
  <key>StandardErrorPath</key><string>{{REPO_DIR}}/data/brief.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
