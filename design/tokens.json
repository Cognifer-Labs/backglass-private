{
  "$comment": "Backglass design tokens. Contrast values are WCAG ratios against the named surface. Validate changes with scripts/validate-palette.mjs.",
  "surfaces": {
    "paper": { "hex": "#FCF8EC", "oklch": [0.979, 0.016, 91.5], "vsBlack": 19.78 },
    "black": { "hex": "#000000" }
  },
  "neutrals": {
    "$comment": "warm ramp, hue 91, tinted to the paper's own hue",
    "50":  { "hex": "#f5eedb", "onPaper": 1.09, "onBlack": 18.14 },
    "100": { "hex": "#e4decd", "onPaper": 1.27, "onBlack": 15.63 },
    "200": { "hex": "#c9c4b5", "onPaper": 1.64, "onBlack": 12.05 },
    "300": { "hex": "#aca79b", "onPaper": 2.26, "onBlack": 8.75 },
    "400": { "hex": "#8e8a81", "onPaper": 3.24, "onBlack": 6.10 },
    "500": { "hex": "#716f67", "onPaper": 4.74, "onBlack": 4.17 },
    "600": { "hex": "#57554f", "onPaper": 7.02, "onBlack": 2.82 },
    "700": { "hex": "#3d3c37", "onPaper": 10.41, "onBlack": 1.90 },
    "800": { "hex": "#252421", "onPaper": 14.62, "onBlack": 1.35 },
    "900": { "hex": "#0e0d0b", "onPaper": 18.29, "onBlack": 1.08 }
  },
  "inks": {
    "$comment": "identical values in both modes; every fill carries a black keyline",
    "vermilion": { "hex": "#D03D37", "onPaper": 4.49, "onBlack": 4.40, "blackTextOn": 4.40, "roles": ["overdue", "series-2"] },
    "gold":      { "hex": "#E8AC1D", "onPaper": 1.91, "onBlack": 10.35, "blackTextOn": 10.35, "roles": ["slipping"], "note": "sub-3:1 on paper by design; keyline plus label is the mitigation" },
    "green":     { "hex": "#249041", "onPaper": 3.85, "onBlack": 5.14, "blackTextOn": 5.14, "roles": ["done", "source-healthy"] },
    "turquoise": { "hex": "#009592", "onPaper": 3.46, "onBlack": 5.71, "blackTextOn": 7.20, "roles": ["awaiting", "series-3"] },
    "cobalt":    { "hex": "#2766C0", "onPaper": 5.28, "onBlack": 3.75, "blackTextOn": 3.75, "roles": ["series-1"], "note": "chart only; never carries text" }
  },
  "series": {
    "$comment": "three maximum; validated all-pairs under protanopia and deuteranopia in both modes",
    "slots": ["#2766C0", "#D03D37", "#009592"],
    "validation": {
      "worstCvdDeltaE": 12.8,
      "worstNormalVisionDeltaE": 17.0,
      "minContrastPaper": 3.46,
      "minContrastBlack": 3.75,
      "model": "Machado-Oliveira-Fernandes 2009, severity 1.0"
    },
    "singleSeries": "#000000"
  },
  "status": {
    "openNotDue":    { "token": "neutral-500", "fill": null },
    "dueToday":      { "token": "black", "fill": "#000000", "text": "paper" },
    "slipping":      { "token": "gold", "fill": "#E8AC1D", "text": "black", "keyline": true },
    "overdue":       { "token": "vermilion", "fill": "#D03D37", "text": "black", "keyline": true },
    "awaitingOthers":{ "token": "turquoise", "fill": "#009592", "text": "black", "keyline": true },
    "done":          { "token": "green", "fill": "#249041", "text": "black", "keyline": true },
    "needsReview":   { "token": "none", "fill": null, "keyline": "2px dashed black" },
    "protectedBlock":{ "token": "black", "fill": "45deg hatch", "keyline": true }
  },
  "geometry": {
    "radius": [3, 6, 10],
    "radiusReel": 3,
    "radiusNesting": "concentric — inner = outer − (padding + border)",
    "border": 2,
    "hairline": 1,
    "shadow": "none",
    "space": [4, 8, 12, 16, 24, 32, 48]
  },
  "type": {
    "body": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "condensed": "\"Helvetica Neue Condensed\", \"Arial Narrow\", system-ui, sans-serif",
    "reel": "ui-monospace, \"SF Mono\", Menlo, monospace",
    "scale": {
      "banner": { "size": 24, "line": 28, "weight": 700, "transform": "uppercase" },
      "title":  { "size": 19, "line": 26, "weight": 700 },
      "body":   { "size": 15, "line": 23, "weight": 400 },
      "small":  { "size": 13, "line": 19, "weight": 400 },
      "label":  { "size": 11, "line": 14, "weight": 700, "transform": "uppercase", "tracking": "0.06em" },
      "reel":   { "size": 22, "line": 22, "weight": 700, "numeric": "tabular-nums" }
    },
    "numerals": "tabular-nums everywhere"
  }
}
