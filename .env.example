# Copy to .env and fill in. .env is gitignored.
# Per-user OAuth tokens live in the `credential` table, not here.
# Only app-level client credentials belong in this file.

# ── identity ──────────────────────────────────────────────────────────
OWNER_NAME=
# Plural, comma-separated. Every address here counts as "the owner" when the
# extractor decides i_owe vs owed_to_me. Was OWNER_EMAIL singular; the owner has
# two addresses. See tasks/todo.md §Deviations #3.
OWNER_EMAILS=
# Single address; never CC.
BRIEF_TO=
# Transactional provider sender, never a Gmail address.
BRIEF_FROM=
# docs/10: never the Gmail API.
RESEND_API_KEY=
DASHBOARD_BASE_URL=http://127.0.0.1:8765

# ── schedule ──────────────────────────────────────────────────────────
DEFAULT_TZ=America/New_York
ALT_TZ=
WORKING_WINDOW=09:00-18:00
# Saturday and Sunday, for owners who plan their weekends. Blank means "same as
# WORKING_WINDOW"; a day with no window at all is one left out of WORKING_DAYS.
WEEKEND_WINDOW=
PEAK_WINDOW=09:00-12:00         # protected deep-work block goes here
WEEK_START=monday
DAILY_RESERVE_MINUTES=45        # never zero; absorbs the first overrun
BRIEF_AT=06:00
# Which days get a window at all. A day left out is unplannable: the planner proposes
# nothing on it, and anything due that day waits in the overflow list unseen. Add
# sat,sun if life happens on the weekend — see WEEKEND_WINDOW above for its hours.
WORKING_DAYS=mon,tue,wed,thu,fri
# The other things in life: name@HH:MM+MINUTES, comma-separated. They render on the
# schedule and the planner plans around them; only the ones inside the working window
# spend capacity (lunch does, breakfast does not). Blank disables.
#
# Add @day to scope one to particular days — banner@16:00+240@wed for a Wednesday
# shift, gym@17:30+60@mon|wed|fri for several. Days are pipe-separated because commas
# already separate routines, and use the same names as WORKING_DAYS. No scope means
# every day, which is what most of life is.
ROUTINES=breakfast@07:30+30,lunch@12:30+45,gym@17:30+60,shower@18:35+25,dinner@19:15+45

# ── planner (docs/04 §1) ──────────────────────────────────────────────
PROTECTED_BLOCK_MINUTES=90      # P6: one contiguous deep-work block per weekday
STALE_AFTER_DAYS=14             # overdue this long folds into the board's Stale section
MIN_BLOCK_MINUTES=25            # P4: anything smaller batches into "small items"
MIN_CAPACITY_MINUTES=60         # P3: under this, propose nothing and say why
ROLLOVER_QUESTION_AT=3          # P11: the drop-or-do question, asked exactly once
# docs/04 §1.3. Never auto-adjusted; the Friday retro reports the ratio and you decide.
ESTIMATE_DEFAULTS=review:30,draft:60,decision:15,meeting_prep:30,unknown:45

# P14: the active timezone is an explicit setting with an optional date range, never IP
# geolocation — which is wrong exactly when you are travelling. Later entries win.
#   TZ_RANGES=2026-08-04..2026-08-22:Asia/Kolkata,2026-11-01:America/Phoenix
TZ_RANGES=

# ── goals (docs/04 §2.5) ──────────────────────────────────────────────
# Staleness and risk are computed independently and never merged (G11).
STALE_WARN_DAYS=7
STALE_SERIOUS_DAYS=14
UNREALISTIC_AFTER_WEEKS=3       # G4: missed this many weeks running → "lower it?"
SLACK_REPORT_FRACTION=0.25      # G7: report slack over this fraction. Slack is information.
RISK_WINDOW_WEEKS=4

# ── model + cost ──────────────────────────────────────────────────────
# anthropic   — the default. The Anthropic API directly: prompt caching on the static
#               prefix, real usage-based cost accounting, and the Batches API path
#               (`backglass batch`) at half price. Key from MODEL_API_KEY or
#               ANTHROPIC_API_KEY. Aliases: haiku→claude-haiku-4-5,
#               sonnet→claude-sonnet-4-6 (extract/pricing.py).
# claude_cli  — the Claude Code CLI on a subscription. No marginal cost if you already
#               pay for one; needs the CLI installed.
# deepinfra   — OpenAI-compatible, open-source models. Cheapest at scale.
# openai_compatible — bring your own endpoint. Same chat-completions dialect as
#               deepinfra, pointed wherever MODEL_BASE_URL says: Ollama or vLLM on
#               localhost, Together, Groq, OpenRouter. A local server needs no key, so
#               MODEL_API_KEY may stay empty; a hosted one will say so at its own 401.
#
# Only claude_cli requires the Claude Code CLI, and only claude_cli reports a cost
# nobody is charged — see MONTHLY_SPEND_CAP_CENTS, which counts those imputed dollars.
# Every other backend here bills real money or, on localhost, none at all.
MODEL_BACKEND=anthropic
MODEL_TRIAGE=haiku              # alias, or a concrete model id for the backend
MODEL_EXTRACT=sonnet
# deepinfra / anthropic; the CLI backend uses your subscription instead.
MODEL_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Where openai_compatible points. Blank falls back to DEEPINFRA_BASE_URL above, so an
# existing config keeps working. Ollama: http://127.0.0.1:11434/v1
MODEL_BASE_URL=

# Retrieval over the drop folder — owner's ruling 2026-08-10, docs/02 revised. Reads
# /v1/embeddings at MODEL_BASE_URL, so a local model indexes signed contracts and scanned
# letters with nothing leaving the machine. `ollama pull nomic-embed-text` first; the
# owner's 1,247 documents indexed in 65 seconds at zero cost.
#
#   backglass search index --all
#   backglass search find "housing contract and the deposit deadline"
#
# Changing this re-indexes rather than mixing vector spaces: two models' vectors are not
# comparable, and ranking them together returns plausible nonsense instead of an error.
EMBEDDING_MODEL=nomic-embed-text

MONTHLY_SPEND_CAP_CENTS=2000    # hard cap; degrades to triage-only when hit
PER_CALL_BUDGET_USD=0.10        # passed to the CLI as --max-budget-usd
PER_ITEM_CHAR_CEILING=60000     # skip and park anything larger (docs/02)
CONFIDENCE_THRESHOLD=0.7        # below this goes to the review queue
DEDUP_THRESHOLD=0.85            # token-set ratio; above this two commitments are one
MAX_CONCURRENCY=6               # model calls in flight; ~5s each

# ── dashboard ─────────────────────────────────────────────────────────
# Extra hostnames the dashboard answers for, beyond loopback. Leave empty
# unless a proxy on THIS machine forwards to 127.0.0.1:8765 — the case being
# `tailscale serve --bg 8765`, which reaches the owner's own devices and
# nothing else. Without the tailnet name here, every proxied request 421s.
#
# Read backglass/web/security.py first. There is no login: whatever reaches
# the dashboard reads and edits the whole ledger. `tailscale funnel` is the
# thing this must never be paired with — that one is the public internet.
DASHBOARD_ALLOWED_HOSTS=

# ── data boundary (docs/08) ───────────────────────────────────────────
# Comma-separated. Evaluated in the connector, BEFORE persistence.
# Any message with a match in From/To/Cc/Bcc is dropped entirely.
#
# full_scope was chosen for v1: neither ingested mailbox carries client
# correspondence. The denylist below is inert under full_scope. If that ever
# stops being true, switch to `exclude`, fill in the domains, and run
# `backglass purge-boundary` — D6 exists for exactly that discovery.
BOUNDARY_MODE=full_scope        # exclude | full_scope
BOUNDARY_DENY_DOMAINS=
BOUNDARY_DENY_ADDRESSES=

# ── connectors ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One label per mailbox, comma-separated. Each becomes a credential row with
# source = "gmail:<label>", because credential is UNIQUE(user_id, source) and
# two accounts cannot both be "gmail". Authorise each with `backglass auth <label>`.
#   e.g. GMAIL_ACCOUNTS=personal,work
GMAIL_ACCOUNTS=

# Rule-layer kills, comma-separated. Domains cover their subdomains; full addresses
# match exactly. Every entry is a model call never made — the cheapest lever on the bill.
# Fill this from `backglass status` when the triage kill rate drops below 85%.
NOISE_SENDERS=

# Sources whose items are consumed deterministically (review tallies feeding goals and
# capacity) and never carry an extractable commitment. Rule-dropped before any model
# call. A bare name covers its labelled variants ("calendar" covers "calendar:personal").
# Add `calendar` only if you accept losing commitments hidden in event descriptions.
STRUCTURED_SOURCES=anki,avorio

# Learned noise: senders the triage model keeps dropping can be promoted into free
# rule-layer drops (`backglass noise suggest` / `promote`). AUTO_PROMOTE lets the sync
# do it unattended once a sender has PROMOTE_AFTER model drops, zero keeps ever, and
# no extracted commitment. Off by default: promotion makes the drop permanent and a
# newly-genuine sender's first ask would be lost silently.
NOISE_AUTO_PROMOTE=false
NOISE_PROMOTE_AFTER=5

# Template dedup: a recurring mail shape (statement, notification) is rule-dropped for
# free once this many prior siblings were all dropped and none was ever kept. Inspect
# with `backglass noise templates`; backfill pre-existing rows once with --backfill.
TEMPLATE_DROP_AFTER=3

# Batched triage: with BATCH_MIN+ items pending, tier-1 packs ~BATCH_SIZE per model
# call (instruction tokens paid once per batch, not per item). Anything the model
# hedges on with the short excerpt is automatically re-read per-item in full.
TRIAGE_BATCH_SIZE=12
TRIAGE_BATCH_MIN=4

# One label per calendar / Drive account, same rule as GMAIL_ACCOUNTS.
# Authorise each with `backglass auth <label> --source calendar|drive`.
CALENDAR_ACCOUNTS=
DRIVE_ACCOUNTS=

# Obsidian (docs/07 recommends it: markdown on disk, no API, no auth).
# The only connector that breaks if the pipeline moves off this machine.
OBSIDIAN_VAULT_PATH=

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

CANVAS_BASE_URL=
CANVAS_TOKEN=

# ── heartbeat (docs/11 §8) ────────────────────────────────────────────
# How old the newest completed run may get before the dashboard and the brief say
# so. 4x the 30-minute sync cadence: one missed run is weather, four is a dead job.
SYNC_STALE_AFTER_HOURS=2

# ── storage ───────────────────────────────────────────────────────────
DB_PATH=./data/backglass.db
# Where `backglass backup` writes snapshots. Left commented out on purpose: blank would
# mean the repo root. Default is ~/Library/Application Support/Backglass/backups —
# outside the checkout, so a snapshot does not share the fate of the original.
# BACKUP_DIR=

# ── Phase 7 sources (all optional; empty disables) ─────────────────────────
# PAT; assigned issues + PRs become evidence.
GITHUB_TOKEN=
# xoxp- user token.
SLACK_TOKEN=
# Comma-separated conversation IDs, deliberately explicit.
SLACK_CHANNELS=
# ~/Library/Messages/chat.db; needs Full Disk Access.
IMESSAGE_DB_PATH=
# The only conversations read. Group chats by display name, one-to-one threads by the
# other party's phone number or address. Empty means the connector reports unhealthy
# rather than reading your whole message history — an inbox-wide read of a personal
# message store is the wrong default. `backglass imessage chats` lists what is there.
IMESSAGE_CHATS=
# How far back a scan reaches. The cursor stops re-reading what has been seen; this stops
# the first run reaching over an entire archive.
IMESSAGE_LOOKBACK_DAYS=90
# A drop folder; every file becomes a source item.
INBOX_FOLDER_PATH=
# Unzipped Meta "Download Your Information" folder (JSON format).
INSTAGRAM_EXPORT_PATH=
# Comma-separated group-chat titles and people; the ONLY chats read.
INSTAGRAM_CHATS=
# Live lane (experimental, ban risk) — both this and a saved instagrapi
# session file must be set to enable it.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=
# 1 enables; JXA via osascript, Automation permission prompt on first run.
APPLE_NOTES=
# 1 enables; reminders are pre-worded commitments.
APPLE_REMINDERS=
# 1 enables; Contacts.app through the same bridge. Names the phone numbers and Apple IDs
# the Conversations page would otherwise ask you to decide about blind. Writes identifiers
# onto people you already have — no messages, no source items, and it never renames a
# person you have edited.
APPLE_CONTACTS=

# Calendar.app, through the same automation bridge as Notes and Reminders. Reads whatever
# accounts macOS already syncs — including Google ones — so it needs no OAuth client and
# no Full Disk Access, and it is the fastest way to get real events into the day planner.
# The Google connector above is still the right answer when Calendar.app is not set up.
APPLE_CALENDAR=
# Calendars to leave out, comma-separated. Subscribed holiday and birthday feeds would
# otherwise eat the planner's capacity every week.
APPLE_CALENDAR_SKIP=

# Mail.app's local store — the same messages as the Gmail connector above, already synced
# and already authenticated, with no OAuth client to register. Needs Full Disk Access
# (System Settings → Privacy & Security), for the terminal AND for the uv binary that
# launchd runs. The version directory moves with macOS, so point at the parent.
# Example: /Users/you/Library/Mail
APPLE_MAIL_PATH=
# How far back a first scan reaches. Mail carries more notice than a group chat does.
APPLE_MAIL_LOOKBACK_DAYS=120
# Mailboxes that must never be read, by the address they deliver to, comma-separated.
# docs/08's other half: when the denylist is empty because the out-of-scope mail lives in
# an account you have not connected, naming that account here is what keeps it true —
# connecting it to Mail.app later then excludes it instead of quietly ingesting it.
BOUNDARY_OUT_OF_SCOPE_ACCOUNTS=
# 1 = screen mail/messages via Apple's model (PCC) before Claude sees anything.
APPLE_TRIAGE=
APPLE_TRIAGE_SHORTCUT=Backglass Triage

# ── Spaced-repetition sources (empty disables) ─────────────────────────────
# ~/Library/Application Support/Anki2/<profile>/collection.anki2
ANKI_DB_PATH=
# ~/Library/Application Support/Avorio/avorio.db
AVORIO_DB_PATH=
# Cadence target review-day checkpoints land on.
REVIEWS_TARGET_ID=
